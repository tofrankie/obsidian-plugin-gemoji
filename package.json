{
  "name": "obsidian-plugin-gemoji",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "description": "Render emoji shortcodes in reading mode.",
  "author": "Frankie <1426203851@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/tofrankie/obsidian-plugin-gemoji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tofrankie/obsidian-plugin-gemoji.git"
  },
  "bugs": {
    "url": "https://github.com/tofrankie/obsidian-plugin-gemoji/issues",
    "email": "1426203851@qq.com"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "emoji",
    "gemoji",
    "markdown"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "run-s build:plugin deploy:vault",
    "build:plugin": "tsdown",
    "deploy:vault": "node scripts/deploy-vault.js",
    "lint": "run-s lint:eslint lint:prettier typecheck",
    "lint:eslint": "eslint . --cache --fix",
    "lint:prettier": "prettier . --cache --write --log-level silent",
    "test": "vitest run",
    "typecheck": "tsc --build --noEmit",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@tofrankie/commitlint": "^0.0.6",
    "@tofrankie/eslint": "^0.3.1",
    "@tofrankie/prettier": "^0.2.0",
    "@tofrankie/tsconfig": "^0.2.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "node-emoji": "^2.2.0",
    "npm-run-all2": "^9.0.1",
    "obsidian": "^1.13.0",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit"
  }
}
